# Public mobile configuration. Restart Expo after changing these.
# Web preview: http://localhost:3001
# Physical phone (same Wi-Fi): http://YOUR_LAN_IP:3001  (e.g. http://192.168.1.10:3001)
# Find YOUR_LAN_IP with: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: allowlisted Supabase email confirmation/password reset redirect.
# Web: http://localhost:8091/auth/callback
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Server only. Never prefix these with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
CONVERSATION_MODEL=gemini-3.8-flash
AUDIT_MODEL=gemini-3.8-flash
TRANSCRIPTION_MODEL=gemini-3.8-flash
SCENE_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=35000
# Web-only on this machine: 127.0.0.1
# Phone / LAN access: 0.0.0.0
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:8091,http://localhost:8081,http://localhost:8082
EVENTS_FEED_URLS=https://www.calgarylibrary.ca/
