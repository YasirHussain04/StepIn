# Run the backend from the repository root. Copy ../.env.example to ../.env
# for the full configuration, including Supabase. This is an AI-only reference.
# Server-only configuration. Never put this key in Expo or EXPO_PUBLIC_ variables.
GEMINI_API_KEY=
CONVERSATION_MODEL=gemini-3.8-flash
AUDIT_MODEL=gemini-3.8-flash
TRANSCRIPTION_MODEL=gemini-3.8-flash
