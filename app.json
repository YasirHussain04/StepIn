{
  "expo": {
    "name": "StepIn",
    "slug": "stepin",
    "version": "0.2.0",
    "scheme": "stepin",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.stepin.mobile"
    },
    "android": {
      "package": "ca.stepin.mobile",
      "blockedPermissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "StepIn — a little help getting started"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow StepIn to record a voice message only when you tap Record.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
