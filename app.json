{
  "expo": {
    "name": "StepIn",
    "slug": "stepin",
    "version": "0.2.0",
    "scheme": "stepin",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.stepin.mobile"
    },
    "android": {
      "package": "ca.stepin.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "StepIn — a little help getting started"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow StepIn to record a voice message only when you tap Record.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-meta-wearables-dat",
        {
          "urlScheme": "stepin",
          "bluetoothUsageDescription": "StepIn uses Bluetooth to connect to Meta glasses for microphone, speaker, and camera stills."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
