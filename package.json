{
  "name": "stepin",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/run.cjs expo start",
    "android": "node scripts/run.cjs expo start --android",
    "ios": "node scripts/run.cjs expo start --ios",
    "web": "node scripts/run.cjs expo start --web",
    "typecheck": "node scripts/run.cjs tsc --noEmit",
    "test": "node scripts/run.cjs vitest run",
    "export:web": "node scripts/run.cjs expo export --platform web",
    "format": "prettier --write app components src shared server tests scripts README.md VERIFICATION.md app.json package.json tsconfig.json",
    "server": "node scripts/run.cjs tsx server/index.ts",
    "server:watch": "node scripts/run.cjs tsx watch server/index.ts",
    "check:backend": "node scripts/run.cjs tsx scripts/check-backend.ts",
    "check:agents": "node scripts/run.cjs tsx scripts/check-agents.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.1.1",
    "@fastify/cors": "11.4.1",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@google/genai": "3.0.0",
    "@supabase/supabase-js": "2.119.0",
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "expo": "58.0.23",
    "expo-audio": "58.0.11",
    "expo-constants": "58.0.15",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-speech": "58.0.3",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "fastify": "5.12.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "node": "22.22.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
